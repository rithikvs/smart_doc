chroma_db/
**/chroma_db/
*.sqlite3

# Uploaded User Documents & Test Files
uploads/*
**/uploads/*
!**/uploads/.gitkeep
*.pdf
*.doc
*.docx

# Node & Frontend Dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

