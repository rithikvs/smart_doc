# Environment & Secrets (NEVER COMMIT REAL KEYS)
.env
*.env
**/.env
.env.*
!.env.example
!**/.env.example

# Python Virtual Environments & Bytecode
venv/
**/venv/
env/
**/env/
.venv/
**/__pycache__/
**/*.py[cod]
*$py.class
*.egg-info/
dist/
build/
**/build/

